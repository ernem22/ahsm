{
  "name": "agentenv",
  "version": "0.1.0",
  "description": "Install and track agent-harness setup (skills, MCP servers, hooks) from one package list.",
  "type": "module",
  "bin": {
    "agentenv": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:test",
    "cli:diff": "node scripts/cli-diff.mjs",
    "check": "npm run check:eol && npm run check:scripts && npm run typecheck:all && npm test && npm run e2e",
    "check:eol": "node scripts/check-eol.mjs",
    "check:scripts": "node scripts/check-syntax.mjs",
    "e2e": "npm run build && node scripts/e2e.mjs && node scripts/e2e-list.mjs && node scripts/e2e-stale.mjs && node scripts/e2e-update.mjs && node scripts/e2e-remove.mjs",
    "e2e:network": "npm run build && node scripts/e2e.mjs --network",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "jsonc-parser": "^3.3.1",
    "react": "^19.3.1",
    "skills": "^1.8.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "keywords": [
    "agents",
    "ai",
    "cli",
    "tui",
    "skills",
    "mcp",
    "hooks",
    "claude-code",
    "codex",
    "opencode",
    "pi"
  ],
  "files": [
    "dist",
    "catalog",
    "packages",
    "harnesses",
    "providers",
    "requires",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ernem22/agentenv.git"
  },
  "homepage": "https://github.com/ernem22/agentenv",
  "bugs": {
    "url": "https://github.com/ernem22/agentenv/issues"
  },
  "author": "ernem22"
}
